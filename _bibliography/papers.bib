@article{li2026online,
  abbr        = {J Gambl Stud},
  bibtex_show = {true},
  title       = {Online vs. In Person Gambling: Does Exposure to Brick-and-Mortar Gambling Shops Lead to Increased Online Gambling?},
  author      = {Li, Luning and Zhang, Jing and Tranos, Emmanouil},
  journal     = {Journal of Gambling Studies},
  year        = {2026},
  doi         = {10.1007/s10899-026-10566-4},
  abstract    = {As online gambling continues to grow, physical gambling shops remain a prominent feature of our neighbourhoods. We estimate the causal effects of exposure to physical gambling environments on online gambling participation, exploring differences across urban and rural areas, as well as between gaming and betting. Greater exposure to physical gambling shops increases the estimated risk of online gambling: those in the highest exposure decile have approximately 1.49 times the risk of online gambling compared with those in the lowest decile, and the effect is stronger in rural and suburban areas (approximately 1.69 times). Online and land-based gambling are not simply substitutes; a more complex relationship involving both substitution and complementarity exists, depending on the context.},
  dimensions  = {true},
  selected    = {true}
}

@article{li2025gambling,
  abbr        = {Annals AAG},
  bibtex_show = {true},
  title       = {Gambling: A Story of Remarkable Stability in Fast-Changing High Streets},
  author      = {Li, Luning and Tranos, Emmanouil},
  journal     = {Annals of the American Association of Geographers},
  volume      = {115},
  number      = {7},
  pages       = {1577--1595},
  year        = {2025},
  doi         = {10.1080/24694452.2025.2496698},
  pdf         = {https://eprints.gla.ac.uk/364958/},
  abstract    = {Despite all the changes that high streets have undergone in Britain, the presence of gambling venues remained remarkably stable between 2014 and 2023. To uncover this, we first built a longitudinal data set of gambling shops in Great Britain during that period, as such data are not readily available. We then employed simple autoregressive models estimated with random forests, predicting annual gambling shop frequencies during 2015 to 2023 using 2014 frequencies as the sole predictor. Our results show a predictive accuracy of 91.8 percent by 2019, which remained robust at 86.2 percent in 2023, even after the disruptions caused by the COVID-19 pandemic. This stability lays the foundation for understanding vulnerable groups at risk of gambling-related harms.},
  dimensions  = {true},
  selected    = {true}
}

@article{li2024identifying,
  abbr        = {Curr Issues Tour},
  bibtex_show = {true},
  title       = {Identifying tourism attractiveness based on intra-destination tourist behaviour: evidence from Wi-Fi data},
  author      = {Li, Luning and Pei, Zixuan and Li, Qiang and Hao, Fengxin and Chen, Xiang and Chen, Jin},
  journal     = {Current Issues in Tourism},
  volume      = {27},
  number      = {19},
  pages       = {3131--3149},
  year        = {2024},
  doi         = {10.1080/13683500.2023.2252562},
  pdf         = {https://eprints.gla.ac.uk/364966/},
  abstract    = {This study proposes a stay-time-based tourism attractiveness index (STTAI) grounded in time geography theory, treating locations where tourists frequently stay for long periods as highly attractive. Using Wi-Fi probe request data from about 670,000 travellers over one month in the Shichahai scenic area in Beijing, we map intra-destination attractiveness and use regression analysis to examine how environmental factors relate to it.},
  dimensions  = {true},
  selected    = {true}
}

@article{li2023spacetime,
  abbr        = {Curr Issues Tour},
  bibtex_show = {true},
  title       = {Space--time tourist flow patterns in community-based tourism: an application of the empirical orthogonal function to Wi-Fi data},
  author      = {Li, Luning and Chen, Xiang and Zhang, Luyun and Li, Qiang and Yang, Yang and Chen, Jin},
  journal     = {Current Issues in Tourism},
  volume      = {26},
  number      = {18},
  pages       = {3004--3022},
  year        = {2023},
  doi         = {10.1080/13683500.2022.2106826},
  pdf         = {https://eprints.gla.ac.uk/364959/},
  abstract    = {Tracking Wi-Fi probe requests over six months in Beijing's Shichahai area, this study applies the empirical orthogonal function (EOF) to identify the spatial aggregation and temporal patterns of tourist flows, and then examines how weather, air quality and travel days relate to those patterns. It is among the first studies to employ Wi-Fi data to study travel behaviour in community-based tourism.},
  dimensions  = {true}
}

@article{li2021contextualizing,
  abbr        = {TBS},
  bibtex_show = {true},
  title       = {Contextualizing human dynamics: Understanding the semantics of movement trajectories with Wi-Fi data},
  author      = {Li, Luning and Chen, Xiang and Li, Qiang and Tan, Xiaoyue and Chen, Jin and Wang, Dawei and Jia, Pengfei},
  journal     = {Travel Behaviour and Society},
  volume      = {25},
  pages       = {183--192},
  year        = {2021},
  doi         = {10.1016/j.tbs.2021.07.005},
  pdf         = {https://eprints.gla.ac.uk/364969/},
  abstract    = {Using Wi-Fi detectors that capture track points along travellers' trajectories, this study proposes a semantic space--time matrix method to infer the meaning of movement. Applied to the Shichahai scenic area in Beijing with Wi-Fi data from 463,874 individuals over two weeks, the derived semantics were validated against a field survey.},
  dimensions  = {true},
  selected    = {true}
}

