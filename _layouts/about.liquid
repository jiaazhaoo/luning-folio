---
layout: default
---
{% comment %}
  Local override of al_folio_core's about layout: intro (photo, name, role,
  contact links), short bio, research, selected publications, news.
{% endcomment %}
<div class="home">
  <section class="intro">
    {% if page.profile.image %}
      <img
        class="intro-photo"
        src="{{ page.profile.image | prepend: 'assets/img/' | relative_url }}"
        alt="Portrait of {{ site.first_name }} {{ site.last_name }}"
        width="800"
        height="1000"
      >
    {% endif %}
    <div>
      <h1>{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="intro-role">{{ page.subtitle }}</p>
      <p class="intro-links">
        <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a>
        <a href="{{ site.data.socials.cv_pdf | relative_url }}">CV (PDF)</a>
      </p>
    </div>
  </section>

  <section class="bio">{{ content }}</section>

  <section class="home-section">
    <h2><a href="{{ '/research/' | relative_url }}">Research</a></h2>
    {% include research_list.liquid %}
  </section>

  <section class="home-section">
    <h2><a href="{{ '/publications/' | relative_url }}">Selected publications</a></h2>
    <div class="publications">{% bibliography --group_by none --query @*[selected=true]* %}</div>
    <p class="section-more"><a href="{{ '/publications/' | relative_url }}">All publications</a></p>
  </section>

  <section class="home-section">
    <h2><a href="{{ '/news/' | relative_url }}">News</a></h2>
    {% include news_list.liquid limit=5 %}
  </section>
</div>
