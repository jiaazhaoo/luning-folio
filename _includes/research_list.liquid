{% comment %} Research projects as a two-column list; used on the homepage and the research page. {% endcomment %}
{% assign projects = site.projects | sort: 'importance' %}
<ul class="research-list">
  {% for project in projects %}
    <li>
      <a class="research-item" href="{{ project.url | relative_url }}">
        {% if project.img %}
          <img src="{{ project.img | relative_url }}" alt="" loading="lazy">
        {% endif %}
        <span class="research-title">{{ project.title }}</span>
        <span class="research-desc">{{ project.description }}</span>
        {% if project.period %}<span class="research-meta">{{ project.period }}</span>{% endif %}
      </a>
    </li>
  {% endfor %}
</ul>
